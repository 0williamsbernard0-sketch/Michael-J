# NOWPayments
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret

# Admin panel (app/admin) — shared secret, not real admin accounts.
# Pick a long random string. Without this set, /admin is fully locked out.
ADMIN_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Supabase (wire in when you replace the placeholder auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

